# ==============================================================================
# Biến môi trường mẫu cho Server Bridge (Online Deployment)
# Sao chép file này thành .env trên server hoặc điền vào cấu hình PaaS/Docker
# ==============================================================================

# Cổng lắng nghe (Mặc định 9603, các nền tảng PaaS như Render/Railway sẽ tự gán biến PORT)
PORT=9603
HOST=0.0.0.0
NODE_ENV=production

# ------------------------------------------------------------------------------
# BẢO MẬT KHI ĐƯA LÊN ONLINE (RẤT QUAN TRỌNG)
# ------------------------------------------------------------------------------

# 1. API_KEY: Khóa bảo vệ các Endpoint REST (/ask, /v1/chat/completions, /sessions)
# Client (Postman, code của bạn, Next.js, Python SDK...) phải gửi header:
# Authorization: Bearer <API_KEY_CUA_BAN>
# Để trống nếu chạy nội bộ không cần xác thực
API_KEY=sk-bridge-secret-key-change-me

# 2. WORKER_TOKEN: Khóa bảo vệ kết nối WebSocket từ Chrome Extension
# Trên máy cá nhân của bạn, mở Popup Extension -> Dán đúng Token này vào ô "Worker Token"
# Chỉ có Extension của bạn mới được phép nhận và xử lý prompt.
# Để trống nếu không cần xác thực worker
WORKER_TOKEN=worker-secret-token-change-me

# ------------------------------------------------------------------------------
# CẤU HÌNH HIỆU NĂNG & QUEUE (Tùy chọn)
# ------------------------------------------------------------------------------
MAX_QUEUE_SIZE=200
DEFAULT_TIMEOUT_MS=60000
MAX_TURNS_PER_SESSION=15
SESSION_TTL_MS=1800000
MAX_SESSIONS=2000
BODY_LIMIT=50mb
