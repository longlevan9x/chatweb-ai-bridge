{
  "manifest_version": 3,
  "name": "ChatGPT & Gemini Local Web Bridge",
  "version": "2.1.0",
  "description": "Cầu nối điều khiển ChatGPT Web & Google Gemini Web từ máy tính qua WebSocket Bridge",
  "permissions": [
    "tabs",
    "alarms",
    "storage",
    "scripting",
    "sidePanel",
    "identity",
    "clipboardWrite",
    "clipboardRead"
  ],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://*.chatgpt.com/*",
    "*://chat.openai.com/*",
    "*://gemini.google.com/*",
    "http://localhost:9603/*",
    "ws://localhost:9603/*",
    "http://localhost/*",
    "ws://localhost/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://*.chatgpt.com/*",
        "*://chat.openai.com/*"
      ],
      "js": [
        "shared/bridge-constants.js",
        "shared/bridge-utils.js",
        "content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://gemini.google.com/*"
      ],
      "js": [
        "shared/bridge-constants.js",
        "shared/bridge-utils.js",
        "content-gemini.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Mở ChatGPT Bridge Console",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "Command+Shift+B"
      },
      "description": "Mở ChatGPT Bridge Side Panel"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
